# ============================================================================
# SmartSys - configuracion de despliegue
# Copie este archivo como .env y reemplace todos los valores marcados.
# NUNCA confirme el archivo .env en el repositorio.
# ============================================================================

# --- Puertos publicados en el host ---
FRONTEND_PORT=8082
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306
# El backend no se publica en el host: se accede por /api mediante el frontend/Nginx.

# --- Base de datos MySQL ---
MYSQL_DATABASE=smartsys
MYSQL_USER=smartsys
MYSQL_PASSWORD=CAMBIE_ESTA_CLAVE_DE_APLICACION
MYSQL_ROOT_PASSWORD=CAMBIE_ESTA_CLAVE_ROOT

# --- Seguridad ---
# Obligatorio: minimo 32 caracteres aleatorios. Genere uno con:
#   openssl rand -base64 48
JWT_SECRET=CAMBIE_ESTE_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,https://localhost:8443
# En producción con HTTPS debe ser true. En local HTTP usar false.
REFRESH_COOKIE_SECURE=true

# --- Datos de demostracion ---
# true solo en entornos de prueba. En produccion deje false y cree usuarios
# mediante el procedimiento del manual de administracion.
SEED_DEMO=false
SEED_PASSWORD=CAMBIE_ESTA_CLAVE_INICIAL

# --- Operacion ---
ALERTS_CRON=0 0 */6 * * *
TZ=America/Lima
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC

# --- Límite de tasa (por IP; en memoria por instancia) ---
RATE_LIMIT_ENABLED=true
# true solo si el backend está detrás de un proxy de confianza (Nginx/Caddy).
RATE_LIMIT_TRUST_PROXY=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_FORGOT_PER_MINUTE=5
RATE_LIMIT_EXPORT_PER_MINUTE=20

# --- Documentacion de API ---
# En produccion deje ambos en false o proteja Swagger por red.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# --- Respaldos y TLS opcional ---
TLS_PORT=8443
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
